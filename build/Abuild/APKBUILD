pkgname=libiconv
pkgver=1.18
pkgrel=0
pkgdesc="GNU charset conversion library"
arch="all"
license="GPL-3.0-only LGPL-2.1-only"
url="https://www.gnu.org/software/libiconv/"
subpackages="${pkgname}-static ${pkgname}-dev ${pkgname}-doc"
if [[ -z $QNX_BOOTSTRAP  ]]; then
    makedepends="gettext gettext-dev"
    subpackages="$subpackages $pkgname-lang"
fi
source="https://mirror.csclub.uwaterloo.ca/gnu/${pkgname}/${pkgname}-${pkgver}.tar.gz"

build() {
    CFLAGS="$CFLAGS -O2 -D_QNX_SOURCE" \
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --docdir=/usr/share/doc/libiconv \
        --enable-extra-encodings

    # workaround for insecure rpath
    sed -i 's|^hardcode_libdir_flag_spec=.*|hardcode_libdir_flag_spec=""|g' libtool
    sed -i 's|^runpath_var=LD_RUN_PATH|runpath_var=DIE_RPATH_DIE|g' libtool

    make
}

package() {
    make DESTDIR="$pkgdir" install
}
sha512sums="
a55eb3b7b785a78ab8918db8af541c9e11deb5ff4f89d54483287711ed797d87848ce0eafffa7ce26d9a7adb4b5a9891cb484f94bd4f51d3ce97a6a47b4c719a  libiconv-1.18.tar.gz
"
